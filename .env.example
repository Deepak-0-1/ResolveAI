# Application
APP_NAME=ResolveAI
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:8501

# Security — replace in real deployments; never commit real secrets
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
SERVICE_API_KEY=dev-service-api-key-change-me

# Seed accounts (created by: resolveai-seed)
# admin@resolveai.local / admin123!
# customer@resolveai.local / customer123!

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=resolveai
POSTGRES_PASSWORD=resolveai
POSTGRES_DB=resolveai
DATABASE_URL=postgresql+psycopg://resolveai:resolveai@localhost:5432/resolveai

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=resolveai_chunks

# Ollama (local LLM + embeddings)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# RAG chunking / uploads
CHUNK_SIZE=800
CHUNK_OVERLAP=120
UPLOAD_DIR=data/uploads

# Retrieval / escalation (M3/M8)
RETRIEVAL_TOP_K=5
MIN_RETRIEVAL_SCORE=0.25
RETRIEVAL_MODE=hybrid
HYBRID_RRF_K=60
ESCALATE_KEYWORDS=delete workspace,delete account,disable mfa,chargeback,legal hold,ssn,social security

# Timeouts / resilience
LLM_TIMEOUT_SECONDS=60
HTTP_TIMEOUT_SECONDS=30
EMBED_TIMEOUT_SECONDS=120
HTTP_MAX_RETRIES=2
HTTP_RETRY_BACKOFF_SECONDS=0.4
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# Jira Cloud Integration (Optional)
# Configure to enable external Jira investigation & comment publishing
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-jira-email@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=SUP
# Secret used to authenticate inbound Atlassian webhooks
JIRA_WEBHOOK_SECRET=dev-jira-webhook-secret-change-me
# Automatically trigger investigation upon receiving jira:issue_created webhook
JIRA_AUTO_INVESTIGATE=false


